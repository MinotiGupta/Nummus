# Optional environment variables for the backend

# The port FastAPI will run on (defaults to 8000 locally, overridden by Railway in production)
PORT=8000

# PostgreSQL is used when this is set. Example local connection string:
# DATABASE_URL=postgresql+psycopg://nummus:password@localhost:5432/nummus
# If omitted, local development falls back to SQLite at data/razorpay.db.

# Set these only for local mock-event development. The mock route returns 404
# unless both values enable it, so deployments remain closed by default.
# APP_ENV=development
# ENABLE_MOCK_WEBHOOK=true

# Required by the real Razorpay webhook endpoint. Use the webhook secret
# configured in Razorpay Dashboard (not the API key secret).
# RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Path to the SQLite database (defaults to data/razorpay.db)
# DB_PATH=data/razorpay.db
